# Copy to .env.production; never commit actual credentials.
DOMAIN=daryajan.com
ACME_EMAIL=
LINZ_API_KEY=
# Optional: public selected LiDAR tiles do not need this key.
OPENTOPOGRAPHY_API_KEY=
# Optional approved HIRDS order downloads; never expose these to the browser.
DATAHUB_CUSTOMER_ID=
DATAHUB_API_KEY=
# Optional profile only, not required by the web app.
POSTGIS_PASSWORD=
# Defaults; PUBLIC_ORIGIN is normally derived from DOMAIN.
# PUBLIC_ORIGIN=https://daryajan.com
MAX_ACTIVE_JOBS=1
OMP_NUM_THREADS=2
APP_MEMORY_LIMIT=6g
APP_CPUS=4
HTTP_PORT=80
HTTPS_PORT=443
