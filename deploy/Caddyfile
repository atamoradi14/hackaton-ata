{
    email {$ACME_EMAIL}
    admin off
}

{$DOMAIN} {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        -Server
    }
    request_body {
        max_size 8KB
    }
    reverse_proxy app:8765 {
        header_up -Authorization
        transport http {
            response_header_timeout 240s
        }
    }
}
